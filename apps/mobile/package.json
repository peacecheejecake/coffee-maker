{
  "name": "@coffee/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "pnpm --filter @coffee/web build",
    "sync": "pnpm build:web && cap sync",
    "ios": "pnpm sync && cap open ios",
    "android": "pnpm sync && cap open android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "~5.8.3"
  }
}
