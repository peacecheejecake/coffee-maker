# Leave empty for a local-only app. For local Supabase: `pnpm supabase start`, then copy API_URL / ANON_KEY
# from `pnpm supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: web push. Generate with `npx web-push generate-vapid-keys`; the private key goes to the
# notify Edge Function (VAPID_PRIVATE_KEY), the public one here.
VITE_VAPID_PUBLIC_KEY=
