{
  "name": "@coffee/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:ci": "playwright test --grep-invert @visual"
  },
  "dependencies": {
    "@coffee/adapters": "workspace:*",
    "@coffee/app": "workspace:*",
    "@coffee/core": "workspace:*",
    "@coffee/scene": "workspace:*",
    "@coffee/theme": "workspace:*",
    "@coffee/ui": "workspace:*",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "leva": "^0.10.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "~1.1.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
