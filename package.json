{
  "name": "coffee-maker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && vitest run --config scripts/vitest.config.ts",
    "e2e": "pnpm --filter @coffee/web e2e",
    "dev": "pnpm --filter @coffee/web dev",
    "lint": "eslint .",
    "depcheck": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm depcheck && pnpm test",
    "supabase": "supabase",
    "supabase:start": "node scripts/supabase-start.mjs",
    "test:int": "node scripts/with-supabase-env.mjs pnpm --filter @coffee/adapters test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.56.1",
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "~3.2.7",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "supabase": "^2.121.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "~3.2.7"
  },
  "packageManager": "pnpm@12.11.2"
}
